# =====================================================
# 🚀 ENVIRONMENT VARIABLES CHO DOKPLOY
# =====================================================
# Copy nội dung này vào tab "Environment" của Compose service trên Dokploy
# =====================================================

# =====================================================
# 📦 MYSQL DATABASE (BẮT BUỘC)
# =====================================================
# Lấy từ tab "Internal Connection" của MySQL service trong Dokploy
# Ví dụ: mysql-abc123.dokploy.internal hoặc tên container
MYSQL_HOST=your-mysql-internal-host
MYSQL_ROOT_PASSWORD=your-strong-password
MYSQL_DATABASE=petrolimex

# =====================================================
# 🔐 FUEL CREDENTIALS (BẮT BUỘC)
# =====================================================
# Thông tin đăng nhập để scrape dữ liệu từ fuel.net
FUEL_USERNAME=your-fuel-username
FUEL_PASSWORD=your-fuel-password

# =====================================================
# ⚙️ OPTIONAL SETTINGS
# =====================================================
NODE_ENV=production
TZ=Asia/Ho_Chi_Minh

# =====================================================
# 🔗 QR CODE BASE URL (OPTIONAL)
# =====================================================
# URL cơ sở cho QR code links. Nếu không set, sẽ tự detect từ request origin
# Ví dụ: https://fuel.yourdomain.com
NEXT_PUBLIC_BASE_URL=https://your-domain.com

